{
  "name": "@haneoka/vega",
  "version": "0.1.0",
  "description": "Minimal opcode-compatible visual novel engine kernel with lifecycle-scoped plugins and framework adapters",
  "keywords": [
    "visual-novel",
    "adv",
    "game-engine",
    "vue",
    "react",
    "web-component",
    "galgame"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega#readme",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-SCOPE.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/brand/header.svg",
    "docs/brand/favicon.svg",
    "docs/ADV_PRESENTATION_AUDIT.md",
    "docs/RENDERER_KIT.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./engine": {
      "types": "./dist/engine-entry.d.ts",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    },
    "./plugin": {
      "types": "./dist/plugin-entry.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace-entry.d.ts",
      "import": "./dist/marketplace.js",
      "default": "./dist/marketplace.js"
    },
    "./shell": {
      "types": "./dist/shell-entry.d.ts",
      "import": "./dist/shell.js",
      "default": "./dist/shell.js"
    },
    "./preview": {
      "types": "./dist/preview-entry.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./renderer-kit": {
      "types": "./dist/renderer-kit-entry.d.ts",
      "import": "./dist/renderer-kit.js",
      "default": "./dist/renderer-kit.js"
    },
    "./deneb-runtime": {
      "types": "./dist/deneb-runtime-entry.d.ts",
      "import": "./dist/deneb-runtime/deneb-runtime.js",
      "default": "./dist/deneb-runtime/deneb-runtime.js"
    },
    "./vue": {
      "types": "./dist/vue-entry.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./vue/controls": {
      "types": "./dist/vue-controls-entry.d.ts",
      "import": "./dist/vue-controls.js",
      "default": "./dist/vue-controls.js"
    },
    "./vue/player": {
      "types": "./dist/vue-player-entry.d.ts",
      "import": "./dist/vue-player.js",
      "default": "./dist/vue-player.js"
    },
    "./vue/text": {
      "types": "./dist/vue-text-entry.d.ts",
      "import": "./dist/vue-text.js",
      "default": "./dist/vue-text.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @haneoka/vega-protocol run build && pnpm run build:core && pnpm --filter @haneoka/vega-react run build && pnpm --filter @haneoka/vega-web-component run build && pnpm run build:deneb",
    "build:core": "vite build && vue-tsc -p tsconfig.build.json",
    "build:deneb": "vite build --config vite.deneb.config.ts && node scripts/verify-deneb-bundle.mjs",
    "typecheck": "pnpm --filter @haneoka/vega-protocol run typecheck && pnpm run typecheck:core && pnpm --filter @haneoka/vega-react run typecheck && pnpm --filter @haneoka/vega-web-component run typecheck",
    "typecheck:core": "vue-tsc -p tsconfig.json --noEmit",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:distribution",
    "prepack": "pnpm run check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "dependencies": {
    "@haneoka/vega-protocol": "workspace:*",
    "@lucide/vue": "^1.27.0"
  },
  "peerDependencies": {
    "howler": ">=2.2.0 <3",
    "vue": ">=3.5.0 <4"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.39",
    "howler": "2.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vue": "3.5.40",
    "vue-tsc": "^3.3.6"
  }
}
