{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@haneoka/vega/audio": ["../../src/audio-entry.ts"],
      "@haneoka/vega/engine": ["../../src/engine-entry.ts"],
      "@haneoka/vega-protocol": ["../protocol/src/index.ts"],
      "@haneoka/vega-protocol/*": ["../protocol/src/*.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
