{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haneoka.dev/schemas/vega-project-v1.json",
  "title": "Vega Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "title", "entryScene", "scenes"],
  "properties": {
    "format": { "const": "vega-project" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "$ref": "#/$defs/localizedText" },
    "entryScene": { "type": "string", "minLength": 1 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumVersion": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "vega:localization": { "$ref": "#/$defs/projectLocalization" }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/asset" }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      ]
    },
    "projectLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "languages", "defaultLanguage"],
      "properties": {
        "version": { "const": 1 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projectLanguage" }
        },
        "defaultLanguage": { "type": "string", "minLength": 1 },
        "fallbackLanguage": { "type": "string", "minLength": 1 }
      },
      "$comment": "Language tags are canonicalized before uniqueness and declaration checks. defaultLanguage and fallbackLanguage must name declared languages."
    },
    "projectLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/localizedText" },
        "fontAssets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "$comment": "Every fontAssets entry must reference a project asset whose type is font."
    },
    "command": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "integer", "minimum": 0 },
        "index": { "type": "integer", "minimum": 0 },
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "noWait": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commands"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/localizedText" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "metadata": { "type": "object" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": { "enum": ["image", "audio", "video", "model", "font", "data", "other"] },
        "source": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "variants": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "configuration": { "type": "object" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "targets": { "$ref": "#/$defs/pluginTargets" },
        "source": { "$ref": "#/$defs/pluginSource" }
      }
    },
    "pluginTargets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "engineVersion": { "type": "string", "minLength": 1 },
        "apiVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "pluginSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "package"],
          "properties": {
            "type": { "const": "registry" },
            "package": { "type": "string", "minLength": 1 },
            "registry": { "type": "string", "format": "uri" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "integrity"],
          "properties": {
            "type": { "const": "url" },
            "url": { "type": "string", "format": "uri" },
            "integrity": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "workspace" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "key"],
          "properties": {
            "type": { "const": "builtin" },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
